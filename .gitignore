# Unity generated folders (rebuilt automatically, never commit these)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / solution files Unity regenerates
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Crash reports / builds
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# Unity Test Framework leftovers written during builds
/[Aa]ssets/[Rr]esources/PerformanceTestRun*
# old Brotli web build files (GitHub Pages cannot serve them)
/docs/Build/*.br
# temporary files Unity's Web build leaves in the project root
/[Dd]ata/
